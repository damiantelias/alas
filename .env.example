# ── App ──────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Auth ─────────────────────────────────────
JWT_SECRET=cambia_esto_por_algo_muy_largo_y_random
JWT_REFRESH_SECRET=otro_secret_diferente_aqui
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://alas_user:alas_pass@localhost:5432/alas_db

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Supabase (storage de fotos) ───────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_key_aqui

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@alas.app

# ── Pagos ─────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ── App URL ───────────────────────────────────
API_URL=http://localhost:4000
MOBILE_APP_SCHEME=alasapp
