{
  "expo": {
    "name": "Alas",
    "slug": "alas",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "alas",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0a1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alas.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Alas necesita acceso a la camara para verificar tu perfil y tomar fotos.",
        "NSMicrophoneUsageDescription": "Alas necesita acceso al microfono para enviar mensajes de voz.",
        "NSPhotoLibraryUsageDescription": "Alas necesita acceso a tu galeria para subir fotos a tu perfil.",
        "NSLocationWhenInUseUsageDescription": "Alas usa tu ubicacion para mostrarte personas cercanas."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0a1a"
      },
      "package": "com.alas.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#a855f7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Alas usa tus fotos para tu perfil.",
          "cameraPermission": "Alas usa la camara para verificar tu identidad."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Alas usa tu ubicacion para mostrarte personas cercanas."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Alas necesita el microfono para mensajes de voz."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
